{
  "name": "resystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --hostname 0.0.0.0 --port 3002 --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:auth": "node --env-file=.env.local --experimental-strip-types --test tests/auth.integration.mjs"
  },
  "dependencies": {
    "fpreid-connect-sdk": "0.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "16.3.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jsdom": "26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  }
}
