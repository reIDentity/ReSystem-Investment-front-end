# Live platform mode. Server-only; do not prefix these with NEXT_PUBLIC_.
PLATFORM_API_BASE=
PLATFORM_APP_ORIGIN=https://localhost:3002
# Example local backend: http://127.0.0.1:3005/v1
# In platform mode the backend owns reID credentials and session cookies.
# The settings below support the legacy read-only login when API_BASE is empty.
# Dedicated reSystem Investment client registered in reID UAT.
REID_CLIENT_ID=
REID_CLIENT_SECRET=
REID_REDIRECT_URI=https://localhost:3002/api/auth/reid/callback
# On Vercel: https://re-system-investment-front-end.vercel.app/api/auth/reid/callback
REID_BASE_URL=https://uat-wallet.reidentity.net
REID_APP_URL=https://app.reidentity.net
# Generate independently for each environment: openssl rand -hex 32
SESSION_SECRET=
